# GitHub Personal Access Token (optional — public repos work without it)
GITHUB_TOKEN=your_github_pat_here

# Ollama base URL (default local instance)
OLLAMA_BASE_URL=http://localhost:11434

# ChromaDB persistent storage path
CHROMA_DB_PATH=./chroma_db

# Budget limit for regression suite (seconds)
BUDGET_LIMIT_SECONDS=1800

# Flask settings
FLASK_DEBUG=true
FLASK_PORT=5000

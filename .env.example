# ── GitHub ────────────────────────────────────────────────────────────────────
# Personal Access Token — optional for public repos, required for private repos.
# Generate at: https://github.com/settings/tokens  (enable "repo" scope)
GITHUB_TOKEN=your_github_pat_here
GITHUB_USERNAME=your_github_username

# ── Azure AI Inference ────────────────────────────────────────────────────────
#
# AZURE_INFERENCE_ENDPOINT  Full base URL of the Azure AI hub proxy.
#                           The SDK appends /chat/completions and /embeddings automatically.
#                           Example (hackathon hub proxy):
AZURE_INFERENCE_ENDPOINT=https://hub-proxy-service.thankfulfield-16b4d5d6.eastus.azurecontainerapps.io

# AZURE_INFERENCE_KEY  API key sent as:  Authorization: Bearer <key>
AZURE_INFERENCE_KEY=your_api_key_here

# ── Model deployment names ────────────────────────────────────────────────────
# Set these to the deployment names configured in your Azure AI project.
LLM_MODEL=gpt-5-gig
CODE_MODEL=claude-sonnet-5-gig
EMBED_MODEL=text-embedding-3-large-gig

# ── ChromaDB ──────────────────────────────────────────────────────────────────
# Local persistent storage path for vector embeddings.
CHROMA_DB_PATH=./chroma_db

# ── Pipeline Settings ─────────────────────────────────────────────────────────
# Maximum allowed total test suite duration in seconds (default: 30 minutes).
BUDGET_LIMIT_SECONDS=1800

# ── Flask Settings ────────────────────────────────────────────────────────────
FLASK_DEBUG=true
FLASK_PORT=5000

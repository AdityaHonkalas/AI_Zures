# ── GitHub ────────────────────────────────────────────────────────────────────
# Personal Access Token — optional for public repos, required for private repos.
# Generate at: https://github.com/settings/tokens  (enable "repo" scope)
GITHUB_TOKEN=your_github_pat_here
GITHUB_USERNAME=your_github_username

# ── LLM Backend ───────────────────────────────────────────────────────────────
#
# Option A — OpenAI-compatible gateway  (preferred; set GATEWAY_URL to activate)
# ---------------------------------------------------------------------------
# GATEWAY_URL  Full base URL of the OpenAI-compatible gateway endpoint.
#              The code appends /v1/chat/completions and /v1/embeddings automatically.
#              Examples:
#                https://api.us-south.ml.cloud.ibm.com/ml/v1   (IBM watsonx.ai)
#                https://api.openai.com                        (OpenAI)
#                https://your-custom-gateway.example.com       (self-hosted)
GATEWAY_URL=https://your-gateway-url-here

# GATEWAY_KEY  API key sent as:  Authorization: Bearer <key>
GATEWAY_KEY=your_gateway_api_key_here

# Model name overrides for the gateway (leave blank to use default Ollama model names)
# Set these when your gateway uses different aliases for the same model families.
REASONING_MODEL_OVERRIDE=gpt-5-gig
CODE_MODEL_OVERRIDE=gpt-5-gig
EMBEDDING_MODEL_OVERRIDE=text-embedding-3-large-gig

#
# Option B — Ollama REST API  (used when GATEWAY_URL is NOT set)
# ---------------------------------------------------------------------------
# OLLAMA_BASE_URL  Base URL of your Ollama server.
#                  The code appends /api/chat and /api/embeddings.
#                  Option B1 — Ollama cloud:
#OLLAMA_BASE_URL=https://ollama.com
#                  Option B2 — Local Ollama (running on your machine):
#OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434

# OLLAMA_API_KEY  Sent as Authorization: Bearer <key>
#                 Required for authenticated/cloud endpoints; leave blank for local.
OLLAMA_API_KEY=your_ollama_api_key_here

# ── ChromaDB ──────────────────────────────────────────────────────────────────
# Local persistent storage path for vector embeddings.
CHROMA_DB_PATH=./chroma_db

# ── Pipeline Settings ─────────────────────────────────────────────────────────
# Maximum allowed total test suite duration in seconds (default: 30 minutes).
BUDGET_LIMIT_SECONDS=1800

# ── Flask Settings ────────────────────────────────────────────────────────────
FLASK_DEBUG=true
FLASK_PORT=5000
